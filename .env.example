# Environment variables. Copy to .env (API, loader) and apps/web/.env.local (web) and fill in.
# Development works with none of them set except where noted.

# ── API (services/api, prefix JADHR_) ───────────────────────────────────────
JADHR_DATABASE_URL=postgresql+psycopg://jadhr:jadhr@localhost:5442/jadhr
JADHR_ENVIRONMENT=development
JADHR_PUBLIC_BASE_URL=http://localhost:8000
# JSON list of browser origins allowed to call the API directly (the site itself goes through /api/v1).
JADHR_CORS_ORIGINS=["http://localhost:3210"]
JADHR_RATE_LIMIT_PER_MINUTE=600

# ── Loader → web cache expiry after a release loads ─────────────────────────
# Unset: the loader skips the step and says so; pages then serve the previous release for up to a day.
JADHR_WEB_REVALIDATE_URL=http://127.0.0.1:3210/api/revalidate
# Required in production, same value on the web app and the loader (a long random string).
JADHR_REVALIDATE_SECRET=

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Where the Next.js server reaches the API (server-side fetches and the /api/v1 rewrite).
JADHR_API_ORIGIN=http://127.0.0.1:8000
# Public origin of the site: canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ── Production compose (infra/compose.prod.yml, file .env.production on the server) ─
# POSTGRES_PASSWORD=<long random>
# REVALIDATE_SECRET=<long random>          # becomes JADHR_REVALIDATE_SECRET on web and loader
# PUBLIC_URL=https://<domain>              # canonical origin; also NEXT_PUBLIC_SITE_URL at build time
# SITE_ADDRESS=<domain>                    # Caddy obtains TLS for it; ":80" for a plain local run
# DATASET_VERSION=2026.10.0                # data/build/<version> the loader loads
# API_WORKERS=2
# HTTP_PORT=80 HTTPS_PORT=443
