# Environment variables. Copy to .env (API, loader) and apps/web/.env.local (web) and fill in.
# Development works with none of them set except where noted.

# ── API (services/api, prefix JADHR_) ───────────────────────────────────────
JADHR_DATABASE_URL=postgresql+psycopg://jadhr:jadhr@localhost:5442/jadhr
JADHR_ENVIRONMENT=development
JADHR_PUBLIC_BASE_URL=http://localhost:8000
# JSON list of browser origins allowed to call the API directly (the site itself goes through /api/v1).
JADHR_CORS_ORIGINS=["http://localhost:3210"]
JADHR_RATE_LIMIT_PER_MINUTE=600
# Same value on the API and the web app: the web server's renders send it and skip the per-IP limit
# (they all come from one host). Production requires it; unset in development, nothing is exempt.
# The e2e suite runs four browsers from one IP — run the API with a higher limit for it (see CLAUDE.md).
JADHR_INTERNAL_TOKEN=
# OpenSearch (derived search index). Unset or unreachable: search answers from Postgres.
JADHR_SEARCH_URL=http://localhost:9201

# ── Loader → web cache expiry after a release loads ─────────────────────────
# Unset: the loader skips the step and says so; pages then serve the previous release for up to a day.
JADHR_WEB_REVALIDATE_URL=http://127.0.0.1:3210/api/revalidate
# Required in production, same value on the web app and the loader (a long random string).
JADHR_REVALIDATE_SECRET=

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# Where the Next.js server reaches the API (server-side fetches and the /api/v1 rewrite).
JADHR_API_ORIGIN=http://127.0.0.1:8000
# Public origin of the site: canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3210
# Pages a minute one reader's address may ask for, and of them the pages that read the API afresh for each question
# (a search, the concordance, a root in the texts). Counted by the address Caddy names, never this machine's own;
# a page rendered on the server reads the API with the internal token, so these are its per-address limits.
# JADHR_PAGE_RATE_PER_MINUTE=1200
# JADHR_FRESH_PAGE_RATE_PER_MINUTE=120

# ── Production compose (infra/compose.prod.yml, file .env.production on the server) ─
# POSTGRES_PASSWORD=<long random>
# APP_DB_PASSWORD=<long random>           # the API's and the monitor's own role (jadhr_api), never the superuser
# REVALIDATE_SECRET=<long random>          # becomes JADHR_REVALIDATE_SECRET on web and loader
# INTERNAL_TOKEN=<long random>             # becomes JADHR_INTERNAL_TOKEN on api and web
# PUBLIC_URL=https://<domain>              # canonical origin; also NEXT_PUBLIC_SITE_URL at build time
# SITE_ADDRESS=<domain>                    # Caddy obtains TLS for it; ":80" for a plain local run
# DATASET_VERSION=2026.10.0                # data/build/<version> the loader loads
# API_WORKERS=2
# HTTP_PORT=80 HTTPS_PORT=443
# ALERT_WEBHOOK=https://…               # optional: the monitor posts what failed (a Slack-style {"text": …} hook)

# ── Accounts (P6) ─────────────────────────────────────────────────────────────
# Development: with JADHR_MAIL_BACKEND=dev (in .env; unset, no mail is sent and e-mail sign-in is off), sign-in links go
# to an in-memory outbox (GET /api/v1/auth/dev/outbox?email=…), which the e2e suite reads; synced records are
# encrypted with a fixed development key.
JADHR_MAIL_BACKEND=dev Production (infra/compose.prod.yml reads these without the JADHR_ prefix):
# DATA_KEY=<openssl rand -base64 32>        # required; keep a copy off the server — losing it loses synced records
# MAIL_BACKEND=smtp                         # "none" (default) keeps e-mail sign-in off
# MAIL_FROM=Jadhr <no-reply@your.domain>
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=   # redirect URI: https://<domain>/auth/oidc/google
# APPLE_CLIENT_ID= APPLE_TEAM_ID= APPLE_KEY_ID= APPLE_PRIVATE_KEY=   # redirect URI: https://<domain>/api/auth/apple
