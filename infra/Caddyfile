# Public entry point. SITE_ADDRESS is the domain (automatic HTTPS) or ":80" for a plain local run.
{$SITE_ADDRESS::80} {
	# Defaults plus fonts: the KFGQPC font must be served as the signed TTF (no conversion to WOFF2 is
	# allowed), so transport compression is what shrinks it.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
			header Content-Type font/ttf*
			header Content-Type font/otf*
		}
	}

	# The public API goes straight to FastAPI; the web app's own /api/v1 rewrite is only a dev convenience.
	handle /api/v1/* {
		reverse_proxy api:8000
	}
	handle /api/v1 {
		reverse_proxy api:8000
	}

	# Cache expiry is called by the loader inside the network (http://web:3000); never from outside.
	handle /api/revalidate {
		respond 404
	}

	# Hashed build assets never change.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy web:3000
	}

	# What the privacy page says (P6.5, audit 11 F1): the page asked for without its query string (no sign-in
	# token, no search), the address shortened, no headers; kept seven days, then gone.
	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 20
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp \?.* ""
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers delete
				request>tls delete
				resp_headers delete
			}
		}
	}
}
